# Copy to .env and fill in what you need. The server loads .env automatically.

# --- Staff dashboard sign-in ------------------------------------------------
# Without STAFF_PASSWORD the dashboard uses the demo password "brightsmile"
# and prints a warning at startup. Set real values before going live.
STAFF_USER=staff
STAFF_PASSWORD=
# Signs session cookies. Without it, sessions end when the server restarts.
SESSION_SECRET=

# --- AI assistant: set ONE key, the provider is detected automatically ------
# Pin a provider when several keys exist: openai | anthropic | gemini
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible gateways (optional)
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

AI_TIMEOUT_MS=20000

# --- Machine-to-machine access ----------------------------------------------
# Optional shared keys: x-api-key for server-to-server booking/staff calls,
# x-webhook-token for POST /api/enquiries.
API_KEY=
WEBHOOK_TOKEN=

# --- HTTP server and storage ------------------------------------------------
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/booking.db
# CONFIG_PATH=config/business.json

# Set to 1 to silence console delivery output (used by scripts and tests).
NOTIFY_SILENT=0

# Set to "production" on live deployments: the staff session cookie is then
# marked Secure (only sent over HTTPS) and HSTS is sent. Leave empty while
# serving plain HTTP (e.g. a LAN box without TLS), or the login cookie breaks.
NODE_ENV=

# Set to 1 only when this app sits behind a trusted reverse proxy that strips
# and rewrites X-Forwarded-For; rate-limit buckets then use the real client IP.
TRUST_PROXY=0

# --- Reminder/bridge worker --------------------------------------------------
# The server runs the reminder queue and bridge flush internally every minute.
# Disable it only when you point your own cron at POST /api/notifications/process.
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MS=60000

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com/api-keys . Verify the sending domain in Resend first, then
# EMAIL_FROM must be an address on that domain.
RESEND_API_KEY=
EMAIL_FROM=Bright Smile Clinic <hello@yourclinic.com>

# --- SMS and WhatsApp (Twilio) ----------------------------------------------
# https://console.twilio.com . TWILIO_FROM is a Twilio number or messaging
# service sender in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Sender for outbound WhatsApp (e.g. whatsapp:+14155238886); SMS uses TWILIO_FROM.
TWILIO_WHATSAPP_FROM=
# Public URL of this deployment when a reverse proxy rewrites the Host header;
# required for signed Twilio inbound webhooks behind a proxy (scheme + host).
PUBLIC_BASE_URL=

# auto (default): Resend for email, Twilio for SMS when configured, otherwise
# the API logs the message. Pin one with: auto | console | resend | twilio | webhook
NOTIFICATIONS_MODE=auto

# Generic delivery webhook, used when Resend/Twilio are not configured or when
# NOTIFICATIONS_MODE=webhook. Receives JSON {channel, to, subject, body, from}.
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_TOKEN=

# --- Backups ------------------------------------------------------------------
# Optional overrides for `npm run backup` (a consistent SQLite snapshot).
BACKUP_DIR=data/backups
BACKUP_KEEP=14

# --- Bridge to the client's existing system ---------------------------------
# POST target for appointment.created/rescheduled/cancelled events.
BRIDGE_WEBHOOK_URL=
BRIDGE_WEBHOOK_TOKEN=
# Endpoint read by `npm run reconcile` (default: <BRIDGE_WEBHOOK_URL>/appointments)
RECONCILE_URL=

# --- Embedding the widget on the client's website ---------------------------
# Comma-separated origins allowed to frame the chat. Empty = framing disabled.
EMBED_ORIGINS=
